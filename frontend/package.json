{
  "name": "enterprise-rag-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise RAG knowledge base administration shell",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "build": "max build",
    "dev": "cross-env UMI_ENV=dev MOCK=none HOST=127.0.0.1 PORT=5173 max dev",
    "generate:api": "max openapi",
    "check:generated": "npm run generate:api && git diff --exit-code -- ../docs/api/openapi.json src/services/ragApi",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test",
    "check": "npm run biome:check && npm run typecheck && npm run test:unit && npm run build"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "6.2.3",
    "@ant-design/pro-components": "3.1.12-0",
    "@ant-design/x": "2.7.0",
    "@ant-design/x-markdown": "2.7.0",
    "@ant-design/x-sdk": "2.7.0",
    "@tanstack/react-query": "5.100.9",
    "antd": "6.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@umijs/max": "4.6.51",
    "@umijs/max-plugin-openapi": "2.0.3",
    "cross-env": "10.1.0",
    "jest": "30.4.1",
    "jest-environment-jsdom": "30.4.1",
    "swagger-ui-dist": "4.19.1",
    "tailwindcss": "4.3.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  }
}
